{
  "name": "platewise",
  "private": true,
  "version": "1.6.0",
  "description": "Platewise: a local-first, bring-your-own-key AI calorie and nutrition tracker (installable web app).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "tsx tooling/checks/runAll.ts",
    "check:similarity": "tsx tooling/checks/runAll.ts --only similarity",
    "check:banned": "tsx tooling/checks/runAll.ts --only banned",
    "check:assets": "tsx tooling/checks/runAll.ts --only assets",
    "check:licenses": "tsx tooling/checks/runAll.ts --only licenses",
    "check:traps": "tsx tooling/checks/runAll.ts --only traps",
    "check:acceptance": "tsx tooling/checks/runAll.ts --only acceptance",
    "ledger:gaps": "tsx scripts/ledger-gaps.ts",
    "check:bundle": "tsx scripts/bundle-budget.ts",
    "probe:cors": "tsx scripts/ai-cors-probe.ts",
    "parity": "tsx scripts/parity.ts",
    "android:sync": "pnpm build && cap sync android",
    "android:apk": "bash scripts/android/build-apk.sh"
  },
  "dependencies": {
    "@capacitor/core": "7.6.9",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/local-notifications": "7.0.7",
    "dexie": "4.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zxing-wasm": "3.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@capacitor/android": "7.6.9",
    "@capacitor/cli": "7.6.9",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
