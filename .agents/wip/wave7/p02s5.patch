index 0000000..207bbdc
--- /dev/null
+++ b/src/data/storage.ts
@@ -0,0 +1,132 @@
+// Keeping the browser from clearing our storage, and how much of it we use (D-16.8, R06.19).
+//
+// Browsers may clear a site's storage when space runs low, and Safari clears it after a week
+// without a visit unless the app is installed. `navigator.storage.persist()` asks the browser to
+// keep it. The app asks once per device, after the first logged entry (P04-08); Settings shows
+// whether storage is kept and how much is used (P09-15). Where a browser lacks these calls, or one
+// fails, the answer is `unknown` (or no estimate): nothing here throws.
+
+import { transact, type PlatewiseDb } from './db';
+import { guardKey, type Codec } from './guard';
+import { readSetting, type SettingKey } from './settingsSchema';
+
+/** Kept by the browser, may be cleared under pressure, or the browser cannot say. */
+export type PersistenceStatus = 'persistent' | 'best-effort' | 'unknown';
+
+/** Bytes used by this site and the most it may use. */
+export interface StorageUse {
+  usage: number;
+  quota: number;
+}
+
+/** The parts of `navigator.storage` used here; any of them may be missing. */
+export type StorageManagerLike = Partial<
+  Pick<StorageManager, 'persist' | 'persisted' | 'estimate'>
+>;
+
+export interface StorageOptions {
+  /** `navigator.storage` by default; null for none. */
+  storage?: StorageManagerLike | null;
+}
+
+/** The device-only setting that records that this device has asked. */
+export const PERSIST_ASKED_KEY = 'storage.persistAsked' satisfies SettingKey;
+
+function browserStorage(): StorageManagerLike | null {
+  try {
+    // Typed as always present, but missing from older browsers and pages not served over https.
+    return (globalThis.navigator as Navigator | undefined)?.storage ?? null;
+  } catch {
+    return null;
+  }
+}
+
+function managerOf(options: StorageOptions): StorageManagerLike | null {
+  return options.storage === undefined ? browserStorage() : options.storage;
+}
+
+async function statusOf(manager: StorageManagerLike | null): Promise<PersistenceStatus> {
+  if (typeof manager?.persisted !== 'function') return 'unknown';
+  try {
+    return (await manager.persisted()) ? 'persistent' : 'best-effort';
+  } catch {
+    return 'unknown';
+  }
+}
+
+/** Whether storage is kept by the browser now. */
+export function persistenceStatus(options: StorageOptions = {}): Promise<PersistenceStatus> {
+  return statusOf(managerOf(options));
+}
+
+function isAmount(value: unknown): value is number {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0;
+}
+
+/** Bytes used and the quota, or null when the browser cannot say. */
+export async function estimate(options: StorageOptions = {}): Promise<StorageUse | null> {
+  const manager = managerOf(options);
+  if (typeof manager?.estimate !== 'function') return null;
+  try {
+    const { usage, quota } = await manager.estimate();
+    return isAmount(usage) && isAmount(quota) ? { usage, quota } : null;
+  } catch {
+    return null;
+  }
+}
+
+/** The `settings` row of the "asked" flag; any other row or value cannot be read. */
+const readAskedRow: Codec<boolean> = (raw) => {
+  if (typeof raw !== 'object' || raw === null) return null;
+  const { key, value } = raw as { key?: unknown; value?: unknown };
+  if (key !== PERSIST_ASKED_KEY) return null;
+  return readSetting(PERSIST_ASKED_KEY, value) ?? null;
+};
+
+/**
+ * Records that this device asks now, unless it (or another tab) already has. True when the caller
+ * may ask. Claimed before asking, so two tabs never both ask.
+ */
+function claimAsk(db: PlatewiseDb): Promise<boolean> {
+  return transact(db, 'rw', ['settings'], async () => {
+    if (readAskedRow(await db.settings.get(PERSIST_ASKED_KEY)) === true) return false;
+    // An unreadable stored value is kept aside before it is replaced.
+    await guardKey(db, 'settings', PERSIST_ASKED_KEY, readAskedRow);
+    await db.settings.put({ key: PERSIST_ASKED_KEY, value: true });
+    return true;
+  });
+}
+
+async function askOnce(db: PlatewiseDb, manager: StorageManagerLike | null) {
+  const now = await statusOf(manager);
+  if (now === 'persistent' || typeof manager?.persist !== 'function') return now;
+  try {
+    if (!(await claimAsk(db))) return now;
+  } catch {
+    // Without the record the ask could repeat on every start: leave it for another time.
+    return now;
+  }
+  try {
+    return (await manager.persist()) ? 'persistent' : 'best-effort';
+  } catch {
+    return 'unknown';
+  }
+}
+
+/** Per connection: the ask in progress, so calls at the same time share one. */
+const asking = new WeakMap<PlatewiseDb, Promise<PersistenceStatus>>();
+
+/**
+ * Asks the browser to keep the app's storage, once per device (D-16.8); later calls report the
+ * current state without asking again. Never rejects.
+ */
+export function requestPersistence(
+  db: PlatewiseDb,
+  options: StorageOptions = {},
+): Promise<PersistenceStatus> {
+  const running = asking.get(db);
+  if (running) return running;
+  const ask = askOnce(db, managerOf(options)).finally(() => asking.delete(db));
+  asking.set(db, ask);
+  return ask;
+}
diff --git a/src/data/wipe.test.ts b/src/data/wipe.test.ts
