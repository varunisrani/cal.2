@@ -0,0 +1,120 @@
+// The device key, and sealing short secrets with it (D-16.51).
+//
+// One AES-GCM 256 key per browser profile, made by Web Crypto as non-extractable: code on this
+// site can encrypt and decrypt with it but can never read its bytes. IndexedDB keeps it in `meta`
+// as a structured clone of the CryptoKey. Each value is sealed under a fresh random 12-byte IV.
+// This protects copies of the raw storage files only; code running on the site can still use the
+// key, which Settings says plainly (D-16.7).
+
+import { transact, type PlatewiseDb } from './db';
+
+/** The `meta` key the device key is stored under. */
+export const DEVICE_KEY = 'deviceKey';
+
+const ALGORITHM = 'AES-GCM';
+const KEY_BITS = 256;
+/** Bytes of the random IV: the 96 bits AES-GCM is designed for. */
+export const IV_BYTES = 12;
+/** Bytes of the authentication tag AES-GCM appends to every sealed value. */
+const TAG_BYTES = 16;
+
+/** A sealed value as stored: its IV, and the encrypted bytes followed by the tag. */
+export interface Sealed {
+  iv: Uint8Array<ArrayBuffer>;
+  data: Uint8Array<ArrayBuffer>;
+}
+
+/** The browser's Web Crypto, or null where there is none (a page not served over https). */
+export function webCrypto(): SubtleCrypto | null {
+  // Typed as always present, but browsers leave it out of insecure pages.
+  return (globalThis.crypto as Crypto | undefined)?.subtle ?? null;
+}
+
+/** Makes a new device key: AES-GCM 256, non-extractable, for encrypting and decrypting only. */
+export function createDeviceKey(subtle: SubtleCrypto): Promise<CryptoKey> {
+  return subtle.generateKey({ name: ALGORITHM, length: KEY_BITS }, false, ['encrypt', 'decrypt']);
+}
+
+/**
+ * True for a key this module can seal and open with. Checked by its tag and fields rather than
+ * `instanceof`, because a key read back from storage may come from another realm.
+ */
+export function isDeviceKey(value: unknown): value is CryptoKey {
+  if (Object.prototype.toString.call(value) !== '[object CryptoKey]') return false;
+  const key = value as CryptoKey;
+  const algorithm = key.algorithm as Partial<AesKeyAlgorithm>;
+  return (
+    key.type === 'secret' &&
+    algorithm.name === ALGORITHM &&
+    algorithm.length === KEY_BITS &&
+    key.usages.includes('encrypt') &&
+    key.usages.includes('decrypt')
+  );
+}
+
+/** Encrypts `text` under `key` with a fresh random IV. */
+export async function seal(subtle: SubtleCrypto, key: CryptoKey, text: string): Promise<Sealed> {
+  const iv = globalThis.crypto.getRandomValues(new Uint8Array(IV_BYTES));
+  const data = await subtle.encrypt({ name: ALGORITHM, iv }, key, new TextEncoder().encode(text));
+  return { iv, data: new Uint8Array(data) };
+}
+
+/** The text sealed in `sealed`, or null when it cannot be opened (damaged, or another key). */
+export async function unseal(
+  subtle: SubtleCrypto,
+  key: CryptoKey,
+  sealed: Sealed,
+): Promise<string | null> {
+  try {
+    const plain = await subtle.decrypt({ name: ALGORITHM, iv: sealed.iv }, key, sealed.data);
+    return new TextDecoder('utf-8', { fatal: true }).decode(plain);
+  } catch {
+    return null;
+  }
+}
+
+/** A copy of stored bytes (a typed array or an ArrayBuffer, from any realm), or null. */
+function bytesOf(value: unknown): Uint8Array<ArrayBuffer> | null {
+  if (ArrayBuffer.isView(value)) {
+    return new Uint8Array(value.buffer, value.byteOffset, value.byteLength).slice();
+  }
+  if (Object.prototype.toString.call(value) === '[object ArrayBuffer]') {
+    return new Uint8Array(value as ArrayBuffer).slice();
+  }
+  return null;
+}
+
+/** The IV and sealed bytes of a stored value, or null when it does not have their shape. */
+export function readSealed(raw: unknown): Sealed | null {
+  if (typeof raw !== 'object' || raw === null) return null;
+  const fields = raw as { iv?: unknown; data?: unknown };
+  const iv = bytesOf(fields.iv);
+  const data = bytesOf(fields.data);
+  if (!iv || iv.length !== IV_BYTES || !data || data.length < TAG_BYTES) return null;
+  return { iv, data };
+}
+
+/** The stored device key, or null when there is none or the stored value is not a usable key. */
+export async function loadDeviceKey(db: PlatewiseDb): Promise<CryptoKey | null> {
+  const value = (await db.meta.get(DEVICE_KEY))?.value;
+  return isDeviceKey(value) ? value : null;
+}
+
+/**
+ * The stored device key, made and stored on first use. Safe to call at the same time from several
+ * places or tabs: they all end on the key stored first. Storing a new key also empties `secrets`,
+ * because values sealed by a key that is gone can never be opened again.
+ */
+export async function ensureDeviceKey(db: PlatewiseDb, subtle: SubtleCrypto): Promise<CryptoKey> {
+  const stored = await loadDeviceKey(db);
+  if (stored) return stored;
+  // Made before the transaction: a transaction ends when it waits on anything but the database.
+  const fresh = await createDeviceKey(subtle);
+  return transact(db, 'rw', ['meta', 'secrets'], async () => {
+    const current = await loadDeviceKey(db);
+    if (current) return current;
+    await db.secrets.clear();
+    await db.meta.put({ key: DEVICE_KEY, value: fresh });
+    return fresh;
+  });
+}
