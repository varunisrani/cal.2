+++ b/src/data/wipe.ts
@@ -0,0 +1,175 @@
+// Erasing everything the app keeps in this browser (06 §3.15 and §5). This is the only code that
+// deletes the database.
+//
+// In order: tell the other tabs (`erase` on the bus: they close their connection and show a
+// notice), close our connection, delete the database (every table at once: diary, photos, keys,
+// settings, quarantine), then remove the app's own Cache Storage entries and `localStorage` keys,
+// both named with `platewise-`. Nothing else on the origin is touched. Forgetting a running backup
+// and stopping reminder timers happen before this call, in the Erase action (P09-15; R06.5, R06.10).
+
+import { appBus, type AppBus } from './bus';
+import type { PlatewiseDb } from './db';
+import { DB_NAME } from './schema';
+
+/** The name prefix of every cache and `localStorage` key the app owns. */
+export const OWNED_PREFIX = 'platewise-';
+
+/** How long a blocked delete waits for the other tabs after asking them a second time. */
+export const BLOCKED_GRACE_MS = 1_500;
+
+/** The parts of Cache Storage erase uses. */
+export type CacheStore = Pick<CacheStorage, 'keys' | 'delete'>;
+/** The parts of `localStorage` erase uses. */
+export type KeyValueStore = Pick<Storage, 'length' | 'key' | 'removeItem'>;
+
+export interface EraseOptions {
+  /** This tab's connection, closed before the delete. */
+  db?: PlatewiseDb;
+  /** The database to delete: `db`'s, else the app's. */
+  name?: string;
+  /** IndexedDB factory; the browser's by default. */
+  indexedDB?: IDBFactory;
+  /** Where `erase` is posted; the app's bus by default. */
+  bus?: AppBus;
+  /** Cache Storage; the browser's by default, null for none. */
+  caches?: CacheStore | null;
+  /** `localStorage`; the browser's by default, null for none. */
+  localStorage?: KeyValueStore | null;
+  /** The wait for other tabs after a blocked delete; `BLOCKED_GRACE_MS` by default. */
+  pause?: () => Promise<void>;
+}
+
+/** How a queued delete ended. */
+export type DeleteEnd = 'erased' | 'failed';
+
+export type EraseResult =
+  | { kind: 'erased' }
+  /**
+   * Another tab still holds the database open. The delete stays queued and ends once that tab
+   * closes (`finished`); the app's own caches and keys are already gone.
+   */
+  | { kind: 'blocked'; finished: Promise<DeleteEnd> }
+  /** The database could not be deleted; nothing else was removed. */
+  | { kind: 'failed'; error: unknown };
+
+function owned(name: string): boolean {
+  return name.startsWith(OWNED_PREFIX);
+}
+
+function browserCaches(): CacheStore | null {
+  // Typed as always present, but browsers leave it out of pages not served over https.
+  return (globalThis.caches as CacheStorage | undefined) ?? null;
+}
+
+function browserStorage(): KeyValueStore | null {
+  try {
+    // Reading it throws where the browser blocks site data.
+    return (globalThis.localStorage as Storage | undefined) ?? null;
+  } catch {
+    return null;
+  }
+}
+
+function graceWait(): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, BLOCKED_GRACE_MS));
+}
+
+/** Starts deleting `name`: how the request ends, and whether it had to wait for other tabs. */
+function startDelete(factory: IDBFactory, name: string) {
+  const request = factory.deleteDatabase(name);
+  const finished = new Promise<DeleteEnd>((resolve) => {
+    request.onsuccess = () => resolve('erased');
+    request.onerror = () => resolve('failed');
+  });
+  const blocked = new Promise<'blocked'>((resolve) => {
+    request.onblocked = () => resolve('blocked');
+  });
+  return { finished, blocked, error: () => request.error };
+}
+
+/** Deletes the app's own caches. They hold app files only, so a failure is left for next time. */
+async function removeOwnedCaches(store: CacheStore | null): Promise<void> {
+  if (!store) return;
+  try {
+    const names = (await store.keys()).filter(owned);
+    await Promise.all(names.map((name) => store.delete(name).catch(() => false)));
+  } catch {
+    // The service worker replaces its caches on its next update.
+  }
+}
+
+/** Removes the app's own `localStorage` keys. */
+function removeOwnedKeys(store: KeyValueStore | null): void {
+  if (!store) return;
+  try {
+    const keys: string[] = [];
+    for (let i = 0; i < store.length; i++) {
+      const key = store.key(i);
+      if (key !== null && owned(key)) keys.push(key);
+    }
+    for (const key of keys) store.removeItem(key);
+  } catch {
+    // Site data blocked by the browser: there is nothing of ours to remove.
+  }
+}
+
+/**
+ * Erases the database, the app's caches and its `localStorage` keys, after telling the other
+ * tabs. Never rejects: the result says whether the database is gone, still queued behind another
+ * tab, or could not be deleted.
+ */
+export async function eraseEverything(options: EraseOptions = {}): Promise<EraseResult> {
+  const bus = options.bus ?? appBus();
+  const factory = options.indexedDB ?? (globalThis.indexedDB as IDBFactory | undefined);
+  const name = options.name ?? options.db?.name ?? DB_NAME;
+
+  bus.post({ type: 'erase' });
+  options.db?.close();
+  if (!factory) return { kind: 'failed', error: new Error('IndexedDB is not available') };
+
+  let deletion: ReturnType<typeof startDelete>;
+  try {
+    deletion = startDelete(factory, name);
+  } catch (error) {
+    return { kind: 'failed', error };
+  }
+
+  let outcome = await Promise.race([deletion.finished, deletion.blocked]);
+  if (outcome === 'blocked') {
+    // A delete cannot be cancelled, and a second request would only queue behind this one. So
+    // the retry asks the other tabs once more and waits one more round on the same request.
+    bus.post({ type: 'erase' });
+    const pause = options.pause ?? graceWait;
+    outcome = await Promise.race([deletion.finished, pause().then(() => 'blocked' as const)]);
+  }
+  if (outcome === 'failed') return { kind: 'failed', error: deletion.error() };
+
+  await removeOwnedCaches(options.caches === undefined ? browserCaches() : options.caches);
+  removeOwnedKeys(options.localStorage === undefined ? browserStorage() : options.localStorage);
+  return outcome === 'blocked'
+    ? { kind: 'blocked', finished: deletion.finished }
+    : { kind: 'erased' };
+}
+
+export interface CloseOnEraseOptions {
+  /** Where `erase` arrives; the app's bus by default. */
+  bus?: AppBus;
+  /** Shows the "erased in another tab" notice. */
+  onErase?: () => void;
+}
+
+/**
+ * In every tab: when another tab erases everything, closes this tab's connection and calls
+ * `onErase` once. Returns the function that stops listening.
+ */
+export function closeOnErase(db: PlatewiseDb, options: CloseOnEraseOptions = {}): () => void {
+  const bus = options.bus ?? appBus();
+  const stop = bus.subscribe((message, origin) => {
+    // The erasing tab closes its own connection and moves on by itself.
+    if (message.type !== 'erase' || origin !== 'other-tab') return;
+    stop();
+    db.close();
+    options.onErase?.();
+  });
+  return stop;
+}
