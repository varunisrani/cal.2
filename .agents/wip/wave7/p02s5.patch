+import { describe, expect, it, vi } from 'vitest';
+import { freshDbOptions, openTestDb } from '../test/db';
+import type { PlatewiseDb } from './db';
+import { hasUnreadableData } from './guard';
+import {
+  PERSIST_ASKED_KEY,
+  estimate,
+  persistenceStatus,
+  requestPersistence,
+  type StorageManagerLike,
+} from './storage';
+
+/** A browser storage manager that grants (or refuses) persistence when asked. */
+function fakeStorage({ persisted = false, grant = false } = {}) {
+  const state = { persisted };
+  return {
+    persist: vi.fn(() => {
+      if (grant) state.persisted = true;
+      return Promise.resolve(grant);
+    }),
+    persisted: vi.fn(() => Promise.resolve(state.persisted)),
+    estimate: vi.fn(() => Promise.resolve({ usage: 1_234_567, quota: 300_000_000 })),
+  };
+}
+
+async function askedFlag(db: PlatewiseDb): Promise<unknown> {
+  return (await db.settings.get(PERSIST_ASKED_KEY))?.value;
+}
+
+describe('requestPersistence', () => {
+  it('calls persist() once when asked twice in a row, and records the ask', async () => {
+    const db = await openTestDb();
+    const storage = fakeStorage({ grant: false });
+
+    expect(await requestPersistence(db, { storage })).toBe('best-effort');
+    expect(await requestPersistence(db, { storage })).toBe('best-effort');
+
+    expect(storage.persist).toHaveBeenCalledTimes(1);
+    expect(await askedFlag(db)).toBe(true);
+  });
+
+  it('calls persist() once when asked twice at the same time, also from two tabs', async () => {
+    const options = freshDbOptions();
+    const one = await openTestDb(options);
+    const other = await openTestDb(options);
+    const storage = fakeStorage({ grant: true });
+
+    const answers = await Promise.all([
+      requestPersistence(one, { storage }),
+      requestPersistence(one, { storage }),
+      requestPersistence(other, { storage }),
+    ]);
+
+    expect(storage.persist).toHaveBeenCalledTimes(1);
+    expect(answers[0]).toBe('persistent');
+    expect(answers[1]).toBe('persistent');
+  });
+
+  it('does not ask again on a later start of the app', async () => {
+    const options = freshDbOptions();
+    const first = await openTestDb(options);
+    await requestPersistence(first, { storage: fakeStorage() });
+    first.close();
+
+    const later = await openTestDb(options);
+    const storage = fakeStorage();
+    expect(await requestPersistence(later, { storage })).toBe('best-effort');
+    expect(storage.persist).not.toHaveBeenCalled();
+  });
+
+  it('reports a grant as persistent', async () => {
+    const db = await openTestDb();
+    const storage = fakeStorage({ grant: true });
+
+    expect(await requestPersistence(db, { storage })).toBe('persistent');
+    expect(await persistenceStatus({ storage })).toBe('persistent');
+  });
+
+  it('does not ask when storage is already persistent', async () => {
+    const db = await openTestDb();
+    const storage = fakeStorage({ persisted: true });
+
+    expect(await requestPersistence(db, { storage })).toBe('persistent');
+    expect(storage.persist).not.toHaveBeenCalled();
+    expect(await askedFlag(db)).toBeUndefined();
+  });
+
+  it('reads unknown without navigator.storage, asks nothing and never throws (R06.19)', async () => {
+    const db = await openTestDb();
+    expect('storage' in navigator).toBe(false);
+
+    await expect(requestPersistence(db)).resolves.toBe('unknown');
+    await expect(requestPersistence(db, { storage: null })).resolves.toBe('unknown');
+    expect(await askedFlag(db)).toBeUndefined();
+  });
+
+  it('reads unknown when persist() fails, after recording the ask', async () => {
+    const db = await openTestDb();
+    const storage: StorageManagerLike = {
+      persist: vi.fn(() => Promise.reject(new Error('not allowed'))),
+      persisted: () => Promise.resolve(false),
+    };
+
+    await expect(requestPersistence(db, { storage })).resolves.toBe('unknown');
+    expect(await askedFlag(db)).toBe(true);
+  });
+
+  it('asks without persisted(), and asks nothing without persist()', async () => {
+    const db = await openTestDb();
+    const persist = vi.fn(() => Promise.resolve(true));
+
+    expect(await requestPersistence(db, { storage: { persist } })).toBe('persistent');
+    expect(persist).toHaveBeenCalledTimes(1);
+
+    const other = await openTestDb();
+    const persisted = vi.fn(() => Promise.resolve(false));
+    expect(await requestPersistence(other, { storage: { persisted } })).toBe('best-effort');
+    expect(await askedFlag(other)).toBeUndefined();
+  });
+
+  it('keeps an unreadable stored flag aside, then records the ask over it', async () => {
+    const db = await openTestDb();
+    await db.settings.put({ key: PERSIST_ASKED_KEY, value: 'yes please' });
+    const storage = fakeStorage();
+
+    await requestPersistence(db, { storage });
+
+    expect(storage.persist).toHaveBeenCalledTimes(1);
+    expect(await askedFlag(db)).toBe(true);
+    expect(await db.quarantine.count()).toBe(1);
+    expect(await hasUnreadableData(db)).toBe(true);
+  });
+
+  it('does not ask when the ask cannot be recorded, and does not throw', async () => {
+    const db = await openTestDb();
+    db.close();
+    const storage = fakeStorage();
+
+    await expect(requestPersistence(db, { storage })).resolves.toBe('best-effort');
+    expect(storage.persist).not.toHaveBeenCalled();
+  });
+});
+
+describe('persistenceStatus', () => {
+  it('follows what the browser says now', async () => {
+    expect(await persistenceStatus({ storage: fakeStorage({ persisted: true }) })).toBe(
+      'persistent',
+    );
+    expect(await persistenceStatus({ storage: fakeStorage() })).toBe('best-effort');
+  });
+
+  it('is unknown without navigator.storage or when the call fails (R06.19)', async () => {
+    expect(await persistenceStatus()).toBe('unknown');
+    expect(await persistenceStatus({ storage: null })).toBe('unknown');
+    expect(await persistenceStatus({ storage: {} })).toBe('unknown');
+    const failing = { persisted: () => Promise.reject(new Error('gone')) };
+    expect(await persistenceStatus({ storage: failing })).toBe('unknown');
+  });
+});
+
+describe('estimate', () => {
+  it('returns the bytes used and the quota', async () => {
+    expect(await estimate({ storage: fakeStorage() })).toEqual({
+      usage: 1_234_567,
+      quota: 300_000_000,
+    });
+  });
+
+  it('is null without the API, when it fails or when it leaves out a number', async () => {
+    expect(await estimate()).toBeNull();
+    expect(await estimate({ storage: null })).toBeNull();
+    expect(await estimate({ storage: { estimate: () => Promise.reject(new Error('no')) } })).toBe(
+      null,
+    );
+    expect(await estimate({ storage: { estimate: () => Promise.resolve({ usage: 10 }) } })).toBe(
+      null,
+    );
+    expect(
+      await estimate({ storage: { estimate: () => Promise.resolve({ usage: -1, quota: 5 }) } }),
+    ).toBeNull();
+  });
+});
