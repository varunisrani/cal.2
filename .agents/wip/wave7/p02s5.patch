index 0000000..4adcc05
--- /dev/null
+++ b/src/data/repos/secretsRepo.ts
@@ -0,0 +1,185 @@
+// The person's API keys: one row per slot in `secrets`, each sealed with the device key (D-16.7,
+// D-16.51). A value is trimmed on save (a pasted newline breaks sign-in, R03.20) and a blank value
+// deletes the slot. Reading never stops the app (R03.27): when the device key is missing or a
+// value cannot be opened, every slot reads as unset and the table is emptied, so the person enters
+// their keys again.
+//
+// On purpose outside the record guard: an unreadable row is emptied, not copied into the
+// quarantine, so key material never sits in a table that export, repair or backup code reads.
+// Export and backup code never read this table either (P09 checks it).
+
+import { PROVIDER_IDS, type ProviderId } from '../../ai/catalog/providers';
+import {
+  DEVICE_KEY,
+  ensureDeviceKey,
+  isDeviceKey,
+  loadDeviceKey,
+  readSealed,
+  seal,
+  unseal,
+  webCrypto,
+  type Sealed,
+} from '../crypto';
+import { transact, type PlatewiseDb } from '../db';
+import type { LooseRow } from '../schema';
+import { sameData } from '../values';
+
+/** Where keys go: one slot per AI provider, and `fdc` for the FoodData Central key. */
+export type SecretSlot = ProviderId | 'fdc';
+
+/** Every slot, in the order `slots()` lists them. */
+export const SECRET_SLOTS: readonly SecretSlot[] = [...PROVIDER_IDS, 'fdc'];
+
+export function isSecretSlot(value: unknown): value is SecretSlot {
+  return typeof value === 'string' && (SECRET_SLOTS as readonly string[]).includes(value);
+}
+
+/** A stored row: the slot and its sealed value. A type literal, so it fits the table's row type. */
+export type SecretRow = {
+  id: SecretSlot;
+  iv: Sealed['iv'];
+  data: Sealed['data'];
+};
+
+/** Saving a key needs Web Crypto, which browsers leave out of pages not served over https. */
+export class SecretsUnavailableError extends Error {
+  override readonly name = 'SecretsUnavailableError';
+
+  constructor() {
+    super('Keys cannot be saved here: this page has no Web Crypto');
+  }
+}
+
+export interface SecretsRepoOptions {
+  /** The Web Crypto to use; the browser's by default, null for none. */
+  subtle?: SubtleCrypto | null;
+}
+
+export interface SecretsRepo {
+  /** Stores `value`, trimmed, in `slot`; a blank value deletes the slot. */
+  set(slot: SecretSlot, value: string): Promise<void>;
+  /**
+   * The value in `slot`, or null when there is none. Null also when it cannot be opened: then
+   * every slot is emptied.
+   */
+  get(slot: SecretSlot): Promise<string | null>;
+  /** The slots that hold a value, in `SECRET_SLOTS` order. Never returns the values. */
+  slots(): Promise<SecretSlot[]>;
+}
+
+/** A row that could not be opened, as it was read. */
+interface Failed {
+  id: string;
+  raw: LooseRow;
+}
+
+/** How many characters `mask` shows at each end. */
+const SHOWN = 4;
+/** What a value too short to show any of it masks to (always the same length). */
+const DOTS = '••••••••';
+
+/** A saved key as Settings shows it: the first and last 4 characters (ACC-E14-1). */
+export function mask(value: string): string {
+  if (value === '') return '';
+  if (value.length <= SHOWN * 2) return DOTS;
+  return `${value.slice(0, SHOWN)}…${value.slice(-SHOWN)}`;
+}
+
+function checkSlot(slot: SecretSlot): void {
+  if (!isSecretSlot(slot)) throw new RangeError(`${String(slot)} is not a key slot`);
+}
+
+export function createSecretsRepo(db: PlatewiseDb, options: SecretsRepoOptions = {}): SecretsRepo {
+  const subtle = (): SubtleCrypto | null =>
+    options.subtle === undefined ? webCrypto() : options.subtle;
+
+  /** The device key and the rows, read together. */
+  function snapshot<T>(rows: () => Promise<T>): Promise<{ key: CryptoKey | null; rows: T }> {
+    return transact(db, 'r', ['meta', 'secrets'], async () => ({
+      key: await loadDeviceKey(db),
+      rows: await rows(),
+    }));
+  }
+
+  /**
+   * Empties the table (R03.27): the device key is missing, or `failed` could not be opened. Checks
+   * again inside the transaction, so a key or value saved since the read is not wiped.
+   */
+  async function forgetAll(failed?: Failed): Promise<void> {
+    await transact(db, 'rw', ['meta', 'secrets'], async () => {
+      const stored = await db.meta.get(DEVICE_KEY);
+      if (failed) {
+        if (!sameData(await db.secrets.get(failed.id), failed.raw)) return;
+      } else if (isDeviceKey(stored?.value)) {
+        // A save stored a key since the read; storing it emptied the table already.
+        return;
+      }
+      await db.secrets.clear();
+      if (stored !== undefined && !isDeviceKey(stored.value)) await db.meta.delete(DEVICE_KEY);
+    });
+  }
+
+  /** Opens one stored row, or null when it cannot be opened. */
+  async function open(cipher: SubtleCrypto, key: CryptoKey, raw: LooseRow): Promise<string | null> {
+    const sealed = readSealed(raw);
+    return sealed ? unseal(cipher, key, sealed) : null;
+  }
+
+  return {
+    async set(slot, value) {
+      checkSlot(slot);
+      const text = value.trim();
+      if (text === '') {
+        await transact(db, 'rw', ['secrets'], async () => {
+          await db.secrets.delete(slot);
+        });
+        return;
+      }
+      const cipher = subtle();
+      if (!cipher) throw new SecretsUnavailableError();
+      // A usable stored key is never replaced (only a missing or unusable one is), so the key
+      // this value is sealed with is still the stored one when the row is written.
+      const key = await ensureDeviceKey(db, cipher);
+      const row: SecretRow = { id: slot, ...(await seal(cipher, key, text)) };
+      await transact(db, 'rw', ['secrets'], async () => {
+        await db.secrets.put(row);
+      });
+    },
+
+    async get(slot) {
+      checkSlot(slot);
+      const cipher = subtle();
+      // Without Web Crypto the values cannot be opened here, but they are fine: keep them.
+      if (!cipher) return null;
+      const { key, rows: raw } = await snapshot(() => db.secrets.get(slot));
+      if (raw === undefined) return null;
+      if (!key) {
+        await forgetAll();
+        return null;
+      }
+      const text = await open(cipher, key, raw);
+      if (text === null) await forgetAll({ id: slot, raw });
+      return text;
+    },
+
+    async slots() {
+      const cipher = subtle();
+      if (!cipher) return [];
+      const { key, rows } = await snapshot(() => db.secrets.toArray());
+      if (rows.length === 0) return [];
+      if (!key) {
+        await forgetAll();
+        return [];
+      }
+      // Every value is opened, so a slot listed here also reads back through `get`.
+      for (const raw of rows) {
+        if ((await open(cipher, key, raw)) === null) {
+          await forgetAll({ id: raw.id, raw });
+          return [];
+        }
+      }
+      const held = new Set(rows.map((row) => row.id));
+      return SECRET_SLOTS.filter((slot) => held.has(slot));
+    },
+  };
+}
