+import { afterEach, describe, expect, it, onTestFinished, vi } from 'vitest';
+import { freshDbOptions, openTestDb, type TestDbOptions } from '../test/db';
+import { createBus, type AppBus } from './bus';
+import type { PlatewiseDb } from './db';
+import { TABLE_NAMES, type TableName } from './schema';
+import { closeOnErase, eraseEverything, type CacheStore } from './wipe';
+
+let channels = 0;
+
+/** A bus channel name of its own for each test; open it twice for two tabs. */
+function channelName(): string {
+  channels += 1;
+  return `platewise-wipe-test-${channels}`;
+}
+
+function openBus(name: string): AppBus {
+  const bus = createBus(name);
+  onTestFinished(() => bus.close());
+  return bus;
+}
+
+/** Cache Storage holding `names`; `held` shows what is left. */
+function fakeCaches(names: string[]): CacheStore & { held: Set<string> } {
+  const held = new Set(names);
+  return {
+    held,
+    keys: () => Promise.resolve([...held]),
+    delete: (name: string) => Promise.resolve(held.delete(name)),
+  };
+}
+
+/** A connection from a tab that ignores `versionchange` and the bus: an older build. */
+function openHolder(options: TestDbOptions): Promise<IDBDatabase> {
+  return new Promise((resolve, reject) => {
+    const request = options.indexedDB.open(options.name);
+    request.onsuccess = () => {
+      const connection = request.result;
+      onTestFinished(() => connection.close());
+      resolve(connection);
+    };
+    request.onerror = () => reject(request.error ?? new Error('open failed'));
+  });
+}
+
+/** One row in every table. */
+async function fillEveryTable(db: PlatewiseDb): Promise<void> {
+  for (const name of TABLE_NAMES) {
+    const table = db.table(name);
+    if (name === 'quarantine') {
+      await table.add({ table: 'entries', key: 'e-1', at: 1, raw: {}, hash: '0' });
+    } else {
+      const keyPath = table.schema.primKey.keyPath as string;
+      await table.put({ [keyPath]: `${name}-1`, value: 1 });
+    }
+  }
+}
+
+async function counts(db: PlatewiseDb): Promise<Record<TableName, number>> {
+  const entries = await Promise.all(
+    TABLE_NAMES.map(async (name) => [name, await db.table(name).count()] as const),
+  );
+  return Object.fromEntries(entries) as Record<TableName, number>;
+}
+
+async function databaseNames(options: TestDbOptions): Promise<(string | undefined)[]> {
+  return (await options.indexedDB.databases()).map((info) => info.name);
+}
+
+afterEach(() => {
+  localStorage.clear();
+});
+
+describe('eraseEverything', () => {
+  it('deletes every table and our caches and storage keys, and nothing of other apps', async () => {
+    const options = freshDbOptions();
+    const db = await openTestDb(options);
+    await fillEveryTable(db);
+    expect(Object.values(await counts(db)).every((count) => count === 1)).toBe(true);
+    const caches = fakeCaches(['platewise-shell-v3', 'platewise-thumbs', 'another-app-v1']);
+    localStorage.setItem('platewise-appearance', 'dark');
+    localStorage.setItem('platewise-last-tab', 'home');
+    localStorage.setItem('another-app-token', 'keep me');
+
+    const result = await eraseEverything({
+      db,
+      name: options.name,
+      indexedDB: options.indexedDB,
+      bus: openBus(channelName()),
+      caches,
+      localStorage,
+    });
+
+    expect(result).toEqual({ kind: 'erased' });
+    expect(db.isOpen()).toBe(false);
+    expect(await databaseNames(options)).not.toContain(options.name);
+    const reopened = await openTestDb(options);
+    expect(Object.values(await counts(reopened)).every((count) => count === 0)).toBe(true);
+    expect([...caches.held]).toEqual(['another-app-v1']);
+    expect(localStorage.getItem('platewise-appearance')).toBeNull();
+    expect(localStorage.getItem('platewise-last-tab')).toBeNull();
+    expect(localStorage.getItem('another-app-token')).toBe('keep me');
+  });
+
+  it('posts erase while our connection is still open, before anything is deleted', async () => {
+    const options = freshDbOptions();
+    const db = await openTestDb(options);
+    const bus = openBus(channelName());
+    const seen: { type: string; open: boolean }[] = [];
+    bus.subscribe((message) => seen.push({ type: message.type, open: db.isOpen() }));
+
+    await eraseEverything({ db, ...options, bus, caches: null, localStorage: null });
+
+    expect(seen).toEqual([{ type: 'erase', open: true }]);
+  });
+
+  it('closes a second open connection, which hears erase and shows its notice once', async () => {
+    const options = freshDbOptions();
+    const channel = channelName();
+    const here = await openTestDb(options);
+    const there = await openTestDb(options);
+    const onErase = vi.fn();
+    const noticed = new Promise<void>((resolve) => {
+      closeOnErase(there, {
+        bus: openBus(channel),
+        onErase: () => {
+          onErase();
+          resolve();
+        },
+      });
+    });
+
+    const result = await eraseEverything({
+      db: here,
+      ...options,
+      bus: openBus(channel),
+      caches: null,
+      localStorage: null,
+    });
+    await noticed;
+
+    expect(result).toEqual({ kind: 'erased' });
+    expect(there.isOpen()).toBe(false);
+    expect(onErase).toHaveBeenCalledTimes(1);
+    expect(await databaseNames(options)).not.toContain(options.name);
+  });
+
+  it('reports blocked after one retry while another tab keeps the database open', async () => {
+    const options = freshDbOptions();
+    const db = await openTestDb(options);
+    const holder = await openHolder(options);
+    const bus = openBus(channelName());
+    const posted: string[] = [];
+    bus.subscribe((message) => posted.push(message.type));
+    const pause = vi.fn(() => Promise.resolve());
+    const caches = fakeCaches(['platewise-shell-v3']);
+    localStorage.setItem('platewise-appearance', 'dark');
+
+    const result = await eraseEverything({ db, ...options, bus, pause, caches, localStorage });
+
+    expect(result.kind).toBe('blocked');
+    expect(posted).toEqual(['erase', 'erase']);
+    expect(pause).toHaveBeenCalledTimes(1);
+    expect(caches.held.size).toBe(0);
+    expect(localStorage.getItem('platewise-appearance')).toBeNull();
+
+    // The delete stays queued and ends once that tab lets go.
+    holder.close();
+    if (result.kind !== 'blocked') throw new Error('expected a blocked erase');
+    expect(await result.finished).toBe('erased');
+    expect(await databaseNames(options)).not.toContain(options.name);
+  });
+
+  it('erases when the other tab lets go after the second broadcast', async () => {
+    const options = freshDbOptions();
+    const channel = channelName();
+    const db = await openTestDb(options);
+    const holder = await openHolder(options);
+    // A tab that only acts on the second erase message (it missed the first one).
+    let heard = 0;
+    openBus(channel).subscribe((message) => {
+      if (message.type === 'erase' && ++heard === 2) holder.close();
+    });
+
+    const result = await eraseEverything({
+      db,
+      ...options,
+      bus: openBus(channel),
+      // Never ends: only the other tab letting go can finish this erase.
+      pause: () => new Promise<void>(() => undefined),
+      caches: null,
+      localStorage: null,
+    });
+
+    expect(result).toEqual({ kind: 'erased' });
+    expect(heard).toBe(2);
+  });
+
+  it('reports a failed delete and leaves caches and storage keys alone', async () => {
+    const failure = new DOMException('The disk is not available', 'UnknownError');
+    const request = {
+      error: failure,
+      onsuccess: null as (() => void) | null,
+      onerror: null as (() => void) | null,
+      onblocked: null as (() => void) | null,
+    };
+    const factory = {
+      deleteDatabase: () => {
+        queueMicrotask(() => request.onerror?.());
+        return request;
+      },
+    } as unknown as IDBFactory;
+    const caches = fakeCaches(['platewise-shell-v3']);
+    localStorage.setItem('platewise-appearance', 'dark');
+
+    const result = await eraseEverything({
+      name: 'platewise-unreachable',
+      indexedDB: factory,
+      bus: openBus(channelName()),
+      caches,
+      localStorage,
+    });
+
+    expect(result).toEqual({ kind: 'failed', error: failure });
+    expect([...caches.held]).toEqual(['platewise-shell-v3']);
+    expect(localStorage.getItem('platewise-appearance')).toBe('dark');
+  });
+
+  it('erases without Cache Storage, which this page does not have', async () => {
+    const options = freshDbOptions();
+    const db = await openTestDb(options);
+    expect('caches' in globalThis).toBe(false);
+
+    const result = await eraseEverything({ db, ...options, bus: openBus(channelName()) });
+
+    expect(result).toEqual({ kind: 'erased' });
+  });
+
+  it('ignores storage that throws, and caches that fail to list', async () => {
+    const options = freshDbOptions();
+    const db = await openTestDb(options);
+    const broken = {
+      get length(): number {
+        throw new DOMException('Site data is blocked', 'SecurityError');
+      },
+      key: () => null,
+      removeItem: () => undefined,
+    };
+
+    const result = await eraseEverything({
+      db,
+      ...options,
+      bus: openBus(channelName()),
+      caches: { keys: () => Promise.reject(new Error('no')), delete: () => Promise.resolve(false) },
+      localStorage: broken,
+    });
+
+    expect(result).toEqual({ kind: 'erased' });
+  });
+});
+
+describe('closeOnErase', () => {
+  it('closes the connection when another tab posts erase, and shows the notice once', async () => {
+    const channel = channelName();
+    const db = await openTestDb();
+    const here = openBus(channel);
+    const there = openBus(channel);
+    const onErase = vi.fn();
+    closeOnErase(db, { bus: here, onErase });
+    let arrivals = 0;
+    const bothArrived = new Promise<void>((resolve) => {
+      here.subscribe(() => {
+        if (++arrivals === 2) resolve();
+      });
+    });
+
+    // The erasing tab posts twice when its delete is blocked.
+    there.post({ type: 'erase' });
+    there.post({ type: 'erase' });
+    await bothArrived;
+
+    expect(db.isOpen()).toBe(false);
+    expect(onErase).toHaveBeenCalledTimes(1);
+  });
+
+  it('ignores an erase posted by its own tab', async () => {
+    const db = await openTestDb();
+    const bus = openBus(channelName());
+    const onErase = vi.fn();
+    closeOnErase(db, { bus, onErase });
+
+    bus.post({ type: 'erase' });
+
+    expect(db.isOpen()).toBe(true);
+    expect(onErase).not.toHaveBeenCalled();
+  });
+
+  it('stops listening when told to', async () => {
+    const channel = channelName();
+    const db = await openTestDb();
+    const here = openBus(channel);
+    const there = openBus(channel);
+    const onErase = vi.fn();
+    const stop = closeOnErase(db, { bus: here, onErase });
+    stop();
+    const arrived = new Promise<void>((resolve) => here.subscribe(() => resolve()));
+
+    there.post({ type: 'erase' });
+    await arrived;
+
+    expect(db.isOpen()).toBe(true);
+    expect(onErase).not.toHaveBeenCalled();
+  });
+});
