<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The web app calls the person's AI provider and the food databases. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Meal photos and the barcode scanner reach the camera through the WebView. The app also
         installs on phones without one (the person can still type or pick a photo). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Health Connect. Each line is one kind of the plugin contract; HealthKinds.kt names the
         same permissions and ManifestTest checks that the two lists agree. Reads: -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <!-- Writes, used only after the person turns write-back on: -->
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />

    <!-- Reminders (P13): Android shows each one at its time, also with the app closed. From
         Android 13 the app asks before it may post notifications; the alarms behind them are set
         again after a restart, which needs the boot broadcast. (The notifications plugin declares
         these too, with WAKE_LOCK.) Inexact alarms are enough, so the exact-alarm permissions are
         kept out even if a library asks for one. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove" />

    <!-- Up to Android 13 Health Connect is a separate app, which the client must be able to see. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Our health privacy note. Health Connect opens it from its permission screens: through
             this action up to Android 13 ... -->
        <activity
            android:name=".health.PrivacyNoteActivity"
            android:exported="true"
            android:label="@string/privacy_note_title"
            android:theme="@style/PrivacyNoteTheme">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- ... and through this alias from Android 14, where only the system may start it. -->
        <activity-alias
            android:name=".health.PermissionUsageAlias"
            android:targetActivity=".health.PrivacyNoteActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Lets the WebView hand the camera app a file to save a new photo into. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true"
            android:authorities="${applicationId}.fileprovider">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
