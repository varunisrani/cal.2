{
  "browser": {
    "mode": "launch",
    "executable_path": "/opt/pw-browsers/chromium-1243/chrome-linux64/chrome",
    "headless": true
  },
  "start_url": { "url": "http://127.0.0.1:4173/" },
  "environment": {
    "viewport": { "width": 412, "height": 839, "device_scale_factor": 2.625 },
    "locale": "en-US",
    "timezone": "UTC",
    "color_scheme": "light",
    "reduced_motion": "reduce",
    "service_workers": "block"
  },
  "actions": [
    {
      "step_id": "wizard.welcome",
      "action": "wait_for",
      "locator": { "kind": "css", "selector": "[data-ui=\"wizard.start\"]" },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "wizard.start",
      "action": "click",
      "locator": { "kind": "css", "selector": "[data-ui=\"wizard.start\"]" },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.sex.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"sex\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.sex.continue",
      "action": "click",
      "locator": { "kind": "css", "selector": "[data-ui=\"wizard.continue\"]" },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.birthday.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"birthday\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.birthday.continue",
      "action": "click",
      "locator": { "kind": "css", "selector": "[data-ui=\"wizard.continue\"]" },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.body.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"body\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.body.continue",
      "action": "click",
      "locator": { "kind": "css", "selector": "[data-ui=\"wizard.continue\"]" },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.body-fat.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"bodyFat\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.body-fat.continue",
      "action": "click",
      "locator": { "kind": "css", "selector": "[data-ui=\"wizard.continue\"]" },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.activity.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"activity\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.activity.continue",
      "action": "click",
      "locator": { "kind": "css", "selector": "[data-ui=\"wizard.continue\"]" },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.goal.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"goal\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.goal.continue",
      "action": "click",
      "locator": { "kind": "css", "selector": "[data-ui=\"wizard.continue\"]" },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.target.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"target\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.target.continue",
      "action": "click",
      "locator": { "kind": "css", "selector": "[data-ui=\"wizard.continue\"]" },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.pace.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"pace\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.pace.continue",
      "action": "click",
      "locator": { "kind": "css", "selector": "[data-ui=\"wizard.continue\"]" },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.reminders.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"reminders\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.reminders.continue",
      "action": "click",
      "locator": { "kind": "css", "selector": "[data-ui=\"wizard.continue\"]" },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.ai-access.shown",
      "action": "wait_for",
      "locator": { "kind": "css", "selector": "[data-ui=\"wizard.ai.later\"]" },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.ai-access.later",
      "action": "click",
      "locator": { "kind": "css", "selector": "[data-ui=\"wizard.ai.later\"]" },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.building-plan",
      "action": "wait_for",
      "locator": { "kind": "css", "selector": "[data-ui=\"wizard.building\"]" },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.plan-ready",
      "action": "wait_for",
      "locator": { "kind": "css", "selector": "[data-ui=\"wizard.plan.finish\"]" },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "wizard.finish",
      "action": "click",
      "locator": { "kind": "css", "selector": "[data-ui=\"wizard.plan.finish\"]" },
      "timeout_ms": 10000
    },
    {
      "step_id": "home.empty-diary",
      "action": "wait_for",
      "locator": { "kind": "css", "selector": "[data-ui=\"home.diary.empty\"]" },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "home.zero-eaten",
      "action": "wait_for",
      "locator": { "kind": "css", "selector": "[data-ui=\"home.gauge\"] :text-is(\"0\")" },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "add.open-menu",
      "action": "click",
      "locator": { "kind": "css", "selector": "[data-ui=\"home.add\"]" },
      "timeout_ms": 10000
    },
    {
      "step_id": "add.enter-manually",
      "action": "click",
      "locator": { "kind": "css", "selector": "[data-ui=\"home.add.manual\"]" },
      "timeout_ms": 10000
    },
    {
      "step_id": "manual.type-name",
      "action": "fill",
      "locator": { "kind": "css", "selector": "[data-ui=\"manual.name\"]" },
      "value": { "source": "literal", "value": "Toast" },
      "timeout_ms": 10000
    },
    {
      "step_id": "manual.type-energy",
      "action": "fill",
      "locator": { "kind": "css", "selector": "[data-ui=\"manual.energy\"]" },
      "value": { "source": "literal", "value": "250" },
      "timeout_ms": 10000
    },
    {
      "step_id": "manual.save",
      "action": "click",
      "locator": { "kind": "css", "selector": "[data-ui=\"manual.save\"]" },
      "timeout_ms": 10000
    },
    {
      "step_id": "manual.closed",
      "action": "wait_for",
      "locator": { "kind": "css", "selector": "[data-ui=\"manual\"]" },
      "state": "detached",
      "timeout_ms": 10000
    },
    {
      "step_id": "entry.under-a-meal",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui^=\"home.meal.\"] [data-ui=\"entry.row\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "gauge.reads-250",
      "action": "wait_for",
      "locator": { "kind": "css", "selector": "[data-ui=\"home.gauge\"] :text-is(\"250\")" },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "reload",
      "action": "goto",
      "destination": { "url": "http://127.0.0.1:4173/" },
      "wait_until": "load",
      "timeout_ms": 30000
    },
    {
      "step_id": "reload.entry-kept",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui^=\"home.meal.\"] [data-ui=\"entry.row\"]"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "reload.gauge-kept",
      "action": "wait_for",
      "locator": { "kind": "css", "selector": "[data-ui=\"home.gauge\"] :text-is(\"250\")" },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "delete.ask",
      "action": "press",
      "locator": { "kind": "css", "selector": "[data-ui=\"entry.row.delete\"]" },
      "key": "Enter",
      "timeout_ms": 10000
    },
    {
      "step_id": "delete.asked",
      "action": "wait_for",
      "locator": { "kind": "css", "selector": "[data-ui=\"entry.delete\"]" },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "delete.cancel",
      "action": "click",
      "locator": { "kind": "css", "selector": "[data-ui=\"entry.delete.cancel\"]" },
      "timeout_ms": 10000
    },
    {
      "step_id": "delete.cancelled",
      "action": "wait_for",
      "locator": { "kind": "css", "selector": "[data-ui=\"entry.delete\"]" },
      "state": "detached",
      "timeout_ms": 10000
    },
    {
      "step_id": "delete.entry-kept",
      "action": "wait_for",
      "locator": { "kind": "css", "selector": "[data-ui=\"entry.row\"]" },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "delete.ask-again",
      "action": "press",
      "locator": { "kind": "css", "selector": "[data-ui=\"entry.row.delete\"]" },
      "key": "Enter",
      "timeout_ms": 10000
    },
    {
      "step_id": "delete.asked-again",
      "action": "wait_for",
      "locator": { "kind": "css", "selector": "[data-ui=\"entry.delete\"]" },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "delete.confirm",
      "action": "click",
      "locator": { "kind": "css", "selector": "[data-ui=\"entry.delete.confirm\"]" },
      "timeout_ms": 10000
    },
    {
      "step_id": "delete.entry-gone",
      "action": "wait_for",
      "locator": { "kind": "css", "selector": "[data-ui=\"entry.row\"]" },
      "state": "detached",
      "timeout_ms": 10000
    },
    {
      "step_id": "delete.empty-diary",
      "action": "wait_for",
      "locator": { "kind": "css", "selector": "[data-ui=\"home.diary.empty\"]" },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "delete.zero-eaten",
      "action": "wait_for",
      "locator": { "kind": "css", "selector": "[data-ui=\"home.gauge\"] :text-is(\"0\")" },
      "state": "visible",
      "timeout_ms": 10000
    }
  ],
  "capture": {
    "after_each_step": ["screenshot", "accessibility", "url"],
    "at_end": ["screenshot", "accessibility", "url"],
    "events": ["page-errors", "network"],
    "network": { "request_body": false, "response_body": false, "header_values": false }
  }
}
