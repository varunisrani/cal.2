        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"reminders\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.reminders.continue",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.continue\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.ai-access.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"aiAccess\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.ai.provider",
      "action": "select_option",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.ai.provider\"]"
      },
      "value": {
        "source": "literal",
        "value": "custom"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.ai.server",
      "action": "fill",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.ai.server\"]"
      },
      "value": {
        "source": "literal",
        "value": "http://127.0.0.1:4320/v1"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.ai.model",
      "action": "fill",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.ai.model.id\"]"
      },
      "value": {
        "source": "literal",
        "value": "platewise-parity"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.ai.terms",
      "action": "check",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.ai.terms\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.ai.ready",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.continue\"]:enabled"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.ai.continue",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.continue\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.plan-ready",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.plan.kcal\"]:has-text(\"2,400\")"
      },
      "state": "visible",
      "timeout_ms": 30000
    },
    {
      "step_id": "wizard.finish",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.plan.finish\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "home.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"home.diary.empty\"]"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "photo.menu",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"home.add\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "photo.group",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"home.add.group.snapScan\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "photo.method",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"home.add.camera\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "capture.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"capture\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "capture.analyse-held",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"capture.analyse\"]:disabled"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "capture.add-photo",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"capture.add\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "capture.photo-card",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"capture.card\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "capture.analyse-ready",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"capture.analyse\"]:enabled"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "capture.note",
      "action": "fill",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"capture.note\"]"
      },
      "value": {
        "source": "literal",
        "value": "a bowl of soup with bread"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "capture.analyse",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"capture.analyse\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "capture.closed",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"capture\"]"
      },
      "state": "detached",
      "timeout_ms": 10000
    },
    {
      "step_id": "review.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"review\"]"
      },
      "state": "visible",
      "timeout_ms": 30000
    },
    {
      "step_id": "review.photo",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"review.photo.1\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "review.kcal-410",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"review.kcal\"]:text-is(\"410\")"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "review.amount-sum",
      "action": "fill",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"review.amount\"]"
      },
      "value": {
        "source": "literal",
        "value": "1+0.5"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "review.amount-done",
      "action": "press",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"review.amount\"]"
      },
      "key": "Enter",
      "timeout_ms": 10000
    },
    {
      "step_id": "review.amount-worked-out",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"review.amount\"][value=\"1.5\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "review.kcal-615",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"review.kcal\"]:text-is(\"615\")"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "review.log",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"review.log\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "review.closed",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"review\"]"
      },
      "state": "detached",
      "timeout_ms": 10000
    },
    {
      "step_id": "diary.row",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"entry.row\"]:has-text(\"Red lentil soup\")"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "gauge.615",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"home.gauge\"] :text-is(\"615\")"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "reload",
      "action": "goto",
      "destination": {
        "url": "http://127.0.0.1:4173/"
      },
      "wait_until": "load",
      "timeout_ms": 30000
    },
    {
      "step_id": "reload.row-kept",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"entry.row\"]:has-text(\"Red lentil soup\")"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "reload.no-review",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"review\"]"
      },
      "state": "detached",
      "timeout_ms": 10000
    }
  ],
  "capture": {
    "after_each_step": ["screenshot", "accessibility", "url"],
    "at_end": ["screenshot", "accessibility", "url"],
    "events": ["page-errors", "network"],
    "network": {
      "request_body": false,
      "response_body": false,
      "header_values": false
    }
  }
}
