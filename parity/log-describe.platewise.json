{
  "browser": {
    "mode": "launch",
    "executable_path": "/opt/pw-browsers/chromium-1243/chrome-linux64/chrome",
    "headless": true
  },
  "start_url": {
    "url": "http://127.0.0.1:4173/"
  },
  "environment": {
    "viewport": {
      "width": 412,
      "height": 839,
      "device_scale_factor": 2.625
    },
    "locale": "en-US",
    "timezone": "UTC",
    "color_scheme": "light",
    "reduced_motion": "reduce",
    "service_workers": "block"
  },
  "actions": [
    {
      "step_id": "wizard.welcome",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.start\"]"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "wizard.start",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.start\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.sex.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"sex\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.sex.continue",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.continue\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.birthday.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"birthday\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.birthday.continue",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.continue\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.body.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"body\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.body.continue",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.continue\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.body-fat.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"bodyFat\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.body-fat.continue",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.continue\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.activity.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"activity\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.activity.continue",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.continue\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.goal.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"goal\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.goal.continue",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.continue\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.target.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"target\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.target.continue",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.continue\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.pace.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"pace\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.pace.continue",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.continue\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.reminders.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"reminders\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.reminders.continue",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.continue\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.ai-access.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"screen.onboarding\"][data-step=\"aiAccess\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.ai.provider",
      "action": "select_option",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.ai.provider\"]"
      },
      "value": {
        "source": "literal",
        "value": "custom"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.ai.server",
      "action": "fill",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.ai.server\"]"
      },
      "value": {
        "source": "literal",
        "value": "http://127.0.0.1:4320/v1"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.ai.model",
      "action": "fill",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.ai.model.id\"]"
      },
      "value": {
        "source": "literal",
        "value": "platewise-parity"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.ai.terms",
      "action": "check",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.ai.terms\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.ai.ready",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.continue\"]:enabled"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.ai.continue",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.continue\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wizard.plan-ready",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.plan.kcal\"]:has-text(\"2,400\")"
      },
      "state": "visible",
      "timeout_ms": 30000
    },
    {
      "step_id": "wizard.finish",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"wizard.plan.finish\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "home.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"home.diary.empty\"]"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "describe.menu",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"home.add\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "describe.group",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"home.add.group.describe\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "describe.method",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"home.add.describe\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "describe.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"describe\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "describe.analyse-held",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"describe.analyse\"]:disabled"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "describe.text",
      "action": "fill",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"describe.text\"]"
      },
      "value": {
        "source": "literal",
        "value": "a bowl of red lentil soup and a slice of wholemeal bread"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "describe.analyse-ready",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"describe.analyse\"]:enabled"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "describe.analyse",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"describe.analyse\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "describe.closed",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"describe\"]"
      },
      "state": "detached",
      "timeout_ms": 10000
    },
    {
      "step_id": "review.shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"review\"]"
      },
      "state": "visible",
      "timeout_ms": 30000
    },
    {
      "step_id": "review.kcal-410",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"review.kcal\"]:text-is(\"410\")"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "review.no-photo",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"review.photos.none\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "reload",
      "action": "goto",
      "destination": {
        "url": "http://127.0.0.1:4173/"
      },
      "wait_until": "load",
      "timeout_ms": 30000
    },
    {
      "step_id": "reload.review-back",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"review\"] [data-ui=\"review.kcal\"]:text-is(\"410\")"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "review.log",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"review.log\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "review.closed",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"review\"]"
      },
      "state": "detached",
      "timeout_ms": 10000
    },
    {
      "step_id": "diary.row",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"entry.row\"]:has-text(\"Red lentil soup\")"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "gauge.410",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"home.gauge\"] :text-is(\"410\")"
      },
      "state": "visible",
      "timeout_ms": 10000
    }
  ],
  "capture": {
    "after_each_step": ["screenshot", "accessibility", "url"],
    "at_end": ["screenshot", "accessibility", "url"],
    "events": ["page-errors", "network"],
    "network": {
      "request_body": false,
      "response_body": false,
      "header_values": false
    }
  }
}
